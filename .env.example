APP_ADDR=:8080
APP_LOG_LEVEL=info

# local | s3 | oss | cos
STORAGE_BACKEND=local

STORAGE_LOCAL_ROOT=./var/objects
STORAGE_LOCAL_PUBLIC_URL=http://localhost:8080/files
STORAGE_LOCAL_SIGN_KEY=change-me

# Server-side encryption (envelope AES-256-GCM). Empty = SSE off.
STORAGE_LOCAL_SSE_KEY=                  # single master passphrase (no rotation)
STORAGE_LOCAL_SSE_KEYFILE=             # path to a versioned key ring (enables rotation); precedence over SSE_KEY.
                                        # JSON: {"primary":"v2","keys":{"v1":"pass","v2":"pass"}}. Objects record their
                                        # key id, so rotating = add a key + move "primary" (no re-encryption). SSE_KEY,
                                        # if also set, decrypts pre-rotation (no-id) objects.
STORAGE_LOCAL_SSE_KEY_URL=              # HTTP secret store (Vault KV) serving the key-ring JSON; precedence over KEYFILE
STORAGE_LOCAL_SSE_KEY_TOKEN=            # optional bearer token for STORAGE_LOCAL_SSE_KEY_URL
STORAGE_LOCAL_SSE_KMS_URL=             # HTTP KMS /wrap+/unwrap endpoint (wrapping key never leaves the KMS); precedence over all above
STORAGE_LOCAL_SSE_KMS_KEY_ID=          # KMS key id used to wrap new data keys
STORAGE_LOCAL_SSE_KMS_TOKEN=           # optional bearer token for STORAGE_LOCAL_SSE_KMS_URL
STORAGE_SSE_REWRAP_ON_START=false       # on boot, re-wrap objects still on an old key id onto the current key
                                        # (rewrites only the sidecar envelope, not bodies) so retired keys can be dropped

# Leave empty to use AWS; for MinIO/OSS-S3/COS-S3 point at the S3-compatible endpoint.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true

# Native Alibaba OSS backend (STORAGE_BACKEND=oss)
STORAGE_OSS_ENDPOINT=
STORAGE_OSS_BUCKET=
STORAGE_OSS_ACCESS_KEY=
STORAGE_OSS_SECRET_KEY=

# Native Tencent COS backend (STORAGE_BACKEND=cos); BucketURL includes bucket+region+appid
STORAGE_COS_BUCKET_URL=
STORAGE_COS_SECRET_ID=
STORAGE_COS_SECRET_KEY=

# sqlite | postgres
DB_DRIVER=sqlite
DB_DSN=file:./var/aero.db?_pragma=foreign_keys(1)
# DB_DRIVER=postgres
# DB_DSN=postgres://aero:aero@localhost:5432/aero_vault?sslmode=disable

# Set empty to disable the S3-compatible router.
S3_COMPAT_PREFIX=/s3

# Background job worker pool. >0 routes indexing through the durable jobs table
# with retry; 0 makes the indexer process events inline.
JOBS_WORKERS=4
JOBS_MAX_DEPTH=0                        # >0: cap pending jobs (backpressure); enqueue is rejected when full

# --- AI / RAG ---------------------------------------------------------------
# Enable text extraction + chunking + embedding of uploaded objects.
AI_INDEX_ENABLED=false
AI_HYBRID_SEARCH=false                  # fuse vector + BM25 with RRF
AI_EMBED_CACHE_SIZE=0                    # >0: memoize up to N embeddings in memory (cuts repeat latency/cost)
AI_SEARCH_CACHE_SIZE=0                   # >0: cache up to N whole search results so identical repeated queries skip embed+retrieval+rerank
AI_SEARCH_CACHE_TTL_SECONDS=30           # TTL bounding staleness of cached search results
AI_REINDEX_STALE_ON_START=false          # on boot, re-index objects whose chunks use a different embed model
AI_VECTOR_BACKEND=                       # ""=brute-force (default); "pgvector"=ANN (needs Postgres+vector ext)
AI_LEXICAL_BACKEND=                      # ""=in-process BM25 (default); "pgfts"=Postgres FTS
AI_VECTOR_DSN=                           # Postgres DSN for pgvector/pgfts backends (when enabled)
# Embeddings: "hash" (built-in, dependency-free) or "http" (OpenAI-compatible).
AI_EMBED_PROVIDER=hash
AI_EMBED_ENDPOINT=                      # e.g. http://localhost:11434 (Ollama)
AI_EMBED_MODEL=text-embedding-3-small
AI_EMBED_API_KEY=
AI_EMBED_DIM=256                        # 768 for nomic-embed-text
# Chat: "mock" (echo, for testing), "http" (OpenAI-compatible), or empty (off).
AI_CHAT_PROVIDER=
AI_CHAT_ENDPOINT=                       # e.g. http://localhost:11434
AI_CHAT_MODEL=gpt-4o-mini
AI_CHAT_API_KEY=
AI_COST_PROMPT_PER_1K=0                 # USD per 1k prompt tokens (0 = don't estimate cost)
AI_COST_COMPLETION_PER_1K=0             # USD per 1k completion tokens
AI_TENANT_DAILY_BUDGET_USD=0            # default per-tenant daily AI spend cap; 0 = unlimited (chat returns 402 when exceeded)
AI_PER_TENANT_BUDGETS=false             # let each tenant override the cap above via PUT /v1/admin/tenants/{t}/budget
# Optional reranker (Cohere/Voyage/bge-reranker wire shape).
AI_RERANK_PROVIDER=
AI_RERANK_ENDPOINT=
AI_RERANK_MODEL=bge-reranker-v2
AI_RERANK_API_KEY=
# Optional remote text extractor (Tika/Unstructured /extract endpoint).
AI_EXTRACTOR_ENDPOINT=
AI_EXTRACTOR_API_KEY=
# PII: scan indexed text and tag the object; optionally redact before embedding.
AI_PII_SCAN=false
AI_PII_REDACT=false

# --- Auth (empty = open / MVP behaviour) ------------------------------------
# token:tenant:scope+scope, comma-separated. tenant "*" = any (operator).
AUTH_KEYS=                              # e.g. prod-rw:acme:read+write,ops:*:admin
AUTH_JWT_SECRET=                        # enables HS256 JWT verification + issuance
AUTH_ANONYMOUS_PUBLIC_READ=false        # allow anonymous GET/HEAD of public-read objects
AUTH_PERSIST_KEYS=false                 # back runtime API keys with the DB (hashed, survive restart); also enables auth
AUTH_KEY_CACHE_TTL_SECONDS=0            # >0 caches persisted-key lookups (skips DB on repeat tokens); cross-replica revokes are
                                        # bounded by this TTL — keep short (e.g. 30). If EVENTS_TRANSPORT_DSN is set, add/revoke
                                        # also propagates immediately via a dedicated LISTEN/NOTIFY channel (aero_key_invalidate).
# AWS SigV4 for the S3 endpoint: accessKey:secretKey:tenant[:scope+scope], comma-separated
S3_SIGV4_CREDENTIALS=                   # e.g. AKIA...:secret...:acme:read+write

# --- Antivirus (async scan via job pool; needs JOBS_WORKERS>0) --------------
AV_ENABLED=false
AV_PROVIDER=signature                   # signature (built-in EICAR) | http
AV_ENDPOINT=                            # external scanner for AV_PROVIDER=http
AV_API_KEY=
AV_QUARANTINE=false                     # soft-delete infected objects

# --- Cross-region replication (async via job pool; needs JOBS_WORKERS>0) ----
REPLICATION_ENABLED=false
REPLICATION_BACKEND=local               # local | s3 | oss | cos
REPLICATION_LOCAL_ROOT=
REPLICATION_LOCAL_SSE_KEYFILE=          # versioned SSE key ring for the local replica (mirror of STORAGE_LOCAL_SSE_KEYFILE)
REPLICATION_S3_ENDPOINT=
REPLICATION_S3_REGION=us-east-1
REPLICATION_S3_BUCKET=
REPLICATION_S3_ACCESS_KEY=
REPLICATION_S3_SECRET_KEY=

# --- Events / webhooks ------------------------------------------------------
EVENTS_WEBHOOK_URL=                     # POST object lifecycle events here
EVENTS_WEBHOOK_SECRET=                  # HMAC-SHA256 sign (X-Aero-Signature)
EVENTS_TRANSPORT=                        # ""=in-process (default); "postgres"=LISTEN/NOTIFY cross-instance fan-out
EVENTS_TRANSPORT_DSN=                    # Postgres DSN for the event transport (when enabled)

# --- Background reconcile / lifecycle ---------------------------------------
RECONCILE_INTERVAL_MINUTES=0            # >0 enables orphan reconcile + lifecycle expiry
RECONCILE_DELETE_ORPHAN_BLOBS=false     # delete blobs with no DB reference
RECONCILE_ORPHAN_GRACE_MINUTES=60       # min age before an orphan blob is eligible for deletion
RECONCILE_TENANTS=                      # comma-separated tenants to scan (empty = default)
RECONCILE_CLUSTER_SINGLETON=false       # multi-replica: run reconcile+lifecycle on only one instance (DB lease)
RECONCILE_RETENTION_DAYS=0              # >0: permanently purge rows soft-deleted longer ago than N days (+ their blobs)
IDEMPOTENCY_TTL_HOURS=0                 # >0: GC idempotency keys older than N hours (bounds the dedupe table)

# --- Telemetry --------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=            # e.g. http://localhost:4318 (OTLP/HTTP)
PROMETHEUS_ENABLED=false                # expose /metrics

# --- Other gateways ---------------------------------------------------------
WEBDAV_PREFIX=                          # e.g. /webdav (empty disables)
WEBUI_ENABLED=true                      # static UI at /ui
RATE_LIMIT_RPS=0                        # per-tenant token bucket (0 = off)
RATE_LIMIT_BURST=0
