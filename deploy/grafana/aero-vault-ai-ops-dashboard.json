{
  "__comment": "aero-vault AI/ops domain-metrics dashboard. Import into Grafana with a Prometheus datasource scraping aero-vault /metrics. Companion to aero-vault-dashboard.json (HTTP metrics).",
  "title": "aero-vault — AI & Ops",
  "uid": "aero-vault-ai-ops",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["aero-vault", "ai", "ops"],
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(storage_bytes, tenant)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "AI spend rate (USD/hour) by tenant",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [
        {
          "expr": "sum by (tenant) (rate(ai_cost_micros_total{tenant=~\"$tenant\"}[5m])) * 3600 / 1e6",
          "legendFormat": "{{tenant}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "AI tokens/sec by model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (model) (rate(ai_tokens_total[5m]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "AI requests/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(ai_requests_total[5m]))", "legendFormat": "requests/s" }
      ]
    },
    {
      "id": 4,
      "title": "Idempotent replays/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(rate(idempotency_replays_total[5m]))", "legendFormat": "replays/s" }
      ]
    },
    {
      "id": 5,
      "title": "Orphan blobs: detected vs deleted (1h increase)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "increase(reconcile_orphan_blobs_total[1h])", "legendFormat": "detected" },
        { "expr": "increase(reconcile_orphan_blobs_deleted_total[1h])", "legendFormat": "deleted" }
      ]
    },
    {
      "id": 6,
      "title": "HTTP 5xx ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_total{status=\"500\"}[5m])) / clamp_min(sum(rate(http_server_requests_total[5m])), 1e-9)",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 7,
      "title": "Embedding latency p50/p95 by model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, model) (rate(ai_embed_duration_ms_bucket[5m])))", "legendFormat": "p50 {{model}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, model) (rate(ai_embed_duration_ms_bucket[5m])))", "legendFormat": "p95 {{model}}" }
      ]
    },
    {
      "id": 8,
      "title": "Search latency p50/p95 by mode",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, mode) (rate(ai_search_duration_ms_bucket[5m])))", "legendFormat": "p50 {{mode}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(ai_search_duration_ms_bucket[5m])))", "legendFormat": "p95 {{mode}}" }
      ]
    },
    {
      "id": 9,
      "title": "Embed requests & tokens/sec by model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        { "expr": "sum by (model) (rate(ai_embed_requests_total[5m]))", "legendFormat": "req/s {{model}}" },
        { "expr": "sum by (model) (rate(ai_embed_tokens_total[5m]))", "legendFormat": "tok/s {{model}}" }
      ]
    },
    {
      "id": 10,
      "title": "Job queue depth (pending)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        { "expr": "jobs_pending", "legendFormat": "pending jobs" }
      ]
    },
    {
      "id": 11,
      "title": "Storage bytes per tenant",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "expr": "storage_bytes{tenant=~\"$tenant\"}", "legendFormat": "{{tenant}}" }
      ]
    },
    {
      "id": 12,
      "title": "Object count per tenant",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "targets": [
        { "expr": "storage_objects{tenant=~\"$tenant\"}", "legendFormat": "{{tenant}}" }
      ]
    }
  ]
}
